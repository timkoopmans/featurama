# ScyllaDB connection settings for Featurama.
# Copy to .env and fill in — .env is gitignored.

# --- Local docker-compose cluster (default) ---
SCYLLA_CONTACT_POINTS=127.0.0.1
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=featurama
SCYLLA_REPLICATION_FACTOR=1

# --- Scylla Cloud cluster ---
# SCYLLA_CONTACT_POINTS=node-0.<cluster>.clusters.scylla.cloud,node-1.<cluster>.clusters.scylla.cloud,node-2.<cluster>.clusters.scylla.cloud
# SCYLLA_USERNAME=scylla
# SCYLLA_PASSWORD=
# SCYLLA_LOCAL_DC=AWS_US_EAST_1
# SCYLLA_REPLICATION_FACTOR=3
# SCYLLA_SSL=0
